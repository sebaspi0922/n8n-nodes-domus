# Copy to a local .env that is never committed.
# Used only by optional integration, workflow, and live Playwright tests.

# Testing-environment token from Domus. Never use a production token here.
DOMUS_TEST_TOKEN=

# Official testing host. Write tests refuse any other URL, including production.
DOMUS_TEST_BASE_URL=https://newapi.domus.la

# Set to 1 only for a manual write cycle on https://newapi.domus.la.
# Created properties cannot be deleted through the API. Nightly CI never sets this.
DOMUS_TEST_WRITE=0

# Optional override when a stable testing property is reserved.
# DOMUS_TEST_PROPERTY_CODE=

# Clean Docker n8n from npm run test:docker
N8N_BASE_URL=http://127.0.0.1:5680

# Disposable owner used by Playwright / workflow tests
N8N_E2E_EMAIL=e2e@n8n-nodes-domus.local
N8N_E2E_PASSWORD=DomusE2ePass1!
N8N_E2E_FIRST_NAME=E2E
N8N_E2E_LAST_NAME=Domus
